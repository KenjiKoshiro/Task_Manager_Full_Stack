    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.542.0",
    "mongoose": "^9.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
