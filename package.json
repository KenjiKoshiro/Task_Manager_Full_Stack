{
  "name": "task-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack task manager with React, Vite, Express, and MongoDB",
  "main": "backend/src/index.js",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "nodemon backend/src/index.js",
